# ============================================================
# Growth OS 环境配置模板
# 复制为 .env 后填写。.env 已被 gitignore，不得提交任何真实密钥。
# ============================================================

# ------------------------------------------------------------
# A. evkg 流水线模型网关（PDF/文档抽取、攻击模块、独立复核）
#    这些变量由 evkg 内部读取，必须保留 EVKG_ 前缀。
# ------------------------------------------------------------
EVKG_LLM_PROVIDER=openai_compatible
EVKG_MODEL=glm-5.3
EVKG_BASE_URL=https://open.bigmodel.cn
EVKG_CHAT_PATH=/api/coding/paas/v4/chat/completions
EVKG_API_KEY=
EVKG_HTTP_TIMEOUT=300
EVKG_HTTP_RETRIES=3
EVKG_MAX_TOKENS=4096
EVKG_REASONING_EFFORT=none
EVKG_EXTRA_BODY={"thinking":{"type":"disabled"}}

# 独立复核模型：强烈建议配置，避免"自己审自己"削弱攻击环节的可信度。
# 注意：evkg 仓库自带的 .env.example 写的是 EVKG_VERIFIER_PROVIDER，那是错的
# （代码实际读取 EVKG_VERIFIER_LLM_PROVIDER），照抄会导致复核模型静默失效。
#EVKG_VERIFIER_LLM_PROVIDER=openai_compatible
#EVKG_VERIFIER_MODEL=
#EVKG_VERIFIER_BASE_URL=
#EVKG_VERIFIER_API_KEY=
#EVKG_VERIFIER_CHAT_PATH=

# 领域包：指向 Growth OS 的成长领域包
EVKG_PROFILE=backend/evidence/profiles/growth_os.yaml

# ------------------------------------------------------------
# B. Growth OS Agent 模型（目标澄清 / 能力审计 / 成长建议）
#    留空则回落到上面 EVKG_ 的配置。
#    建议：Agent 推理质量直接决定能力判定质量，可在此用更强的模型。
#    由 Growth OS 显式以 overrides 传给 evkg.model_gateway.ModelGateway，
#    不依赖进程级全局配置（evkg 的 config._ACTIVE 是进程级的）。
# ------------------------------------------------------------
GROWTH_AGENT_LLM_PROVIDER=
GROWTH_AGENT_MODEL=
GROWTH_AGENT_BASE_URL=
GROWTH_AGENT_API_KEY=
GROWTH_AGENT_CHAT_PATH=

# ------------------------------------------------------------
# C. 存储
# ------------------------------------------------------------
# 用户证据库（含 evkg 表族 + g_ 表族）
GROWTH_DB=data/growth.db
# 项目验收证据库（与用户证据库物理隔离，防止污染能力断言）
GROWTH_ACCEPTANCE_DB=data/acceptance.db

# ------------------------------------------------------------
# D. GitHub 集成（M3 使用）
#    最小权限：MVP 只申请读取公开仓库所需的 scope。
# ------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/integrations/github/callback

# ------------------------------------------------------------
# E. 服务
# ------------------------------------------------------------
GROWTH_HOST=127.0.0.1
GROWTH_PORT=8000
# 主动提醒总开关（用户也可在界面关闭）
GROWTH_PROACTIVE_ENABLED=true
